---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { posts: posts.filter((post) => post.data.tags.some((item) => slugify(item) === slugify(tag))), tag }
  }));
}

const { posts, tag } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged ${tag}.`}>
  <section class="page-heading">
    <h1>{tag}</h1>
  </section>
  <section class="post-list compact">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-card-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <a href={`/categories/${post.data.category.toLowerCase()}/`}>{post.data.category}</a>
        </div>
        <h2><a href={`/${post.data.slug}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>
