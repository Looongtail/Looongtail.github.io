---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Data Engineering / Architecture / SCM / Tech Notes</p>
    <h1>Ben's Bookstore</h1>
    <p class="lede">
      데이터 엔지니어와 아키텍트로 일하며 쌓은 경험을 바탕으로, SCM, 데이터 모델링, 온톨로지 기반 설계, AI 기술 흐름을
      정리합니다. 현장에서 마주친 문제를 구조화하고, 다시 꺼내 쓸 수 있는 생각으로 남깁니다.
    </p>
  </section>

  <section class="post-list" aria-label="Posts">
    {posts.map((post) => (
      <article class="post-card">
        <div class="post-card-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <a href={`/categories/${post.data.category.toLowerCase()}/`}>{post.data.category}</a>
        </div>
        <h2>
          <a href={`/${post.data.slug}/`}>{post.data.title}</a>
        </h2>
        <p>{post.data.description}</p>
        <ul class="tag-list" aria-label="Tags">
          {post.data.tags.map((tag) => (
            <li><a href={`/tags/${tag.toLowerCase().replaceAll(' ', '-')}/`}>{tag}</a></li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</BaseLayout>
